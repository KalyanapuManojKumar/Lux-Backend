# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://funnel.disabilitypath.org

# Meta Conversions API (CAPI)
# Obtain from Meta Events Manager -> Settings -> Generate Access Token
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_PIXEL_ID=your_meta_dataset_or_pixel_id_here
META_API_VERSION=v20.0
# Optional: Set test event code to verify events in Meta Events Manager Test Events tool
META_TEST_EVENT_CODE=

# n8n Automation Webhook
N8N_WEBHOOK_URL=https://n8n.srv1513029.hstgr.cloud/webhook-test/growth-funnel-lead
N8N_WEBHOOK_SECRET=your_n8n_shared_secret_token_here

# Resilience & Rate Limiting
REQUEST_TIMEOUT_MS=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
